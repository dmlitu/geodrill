# Copy to .env for local development (never commit the real .env — it's
# gitignored). Production values are set in the Render dashboard / render.yaml,
# not from this file.

# ── Required in production (see auth.py — the app refuses to start in prod
#    without it; a dev-only fallback key is used automatically if unset locally) ──
SECRET_KEY=

# ── Database — defaults to a local SQLite file if unset ──
DATABASE_URL=

# ── Comma-separated list of frontend origins CORS should allow ──
ALLOWED_ORIGINS=http://localhost:5173

# ── dev | test | local | production — gates local-only CORS origins and
#    the SECRET_KEY dev fallback (see auth.py) ──
ENV=dev

LOG_LEVEL=INFO

# ── Anthropic API key — only needed for the PDF soil-log import feature
#    (routers/soil_import.py) ──
ANTHROPIC_API_KEY=

# ── CAD (DWG/DXF) analysis — modules/cad/ ──
# Path to the DWG->DXF converter executable. Optional: if unset, the app
# looks for `dwg2dxf` (GNU LibreDWG) then `ODAFileConverter` on PATH.
# The production Docker image (backend/Dockerfile) already builds and bakes
# in dwg2dxf and sets this automatically — you only need to set it yourself
# for a non-Docker local setup (`brew install libredwg` on macOS,
# `apt install libredwg-tools` where packaged) or to point at a different
# converter (e.g. a licensed ODAFileConverter install).
GEODRILL_DWG_CONVERTER=

# Seconds to allow the DWG->DXF conversion subprocess to run before it's
# killed. Default: 60. (This is just the converter step — see
# GEODRILL_CAD_PROCESSING_TIMEOUT for the whole request's outer bound.)
GEODRILL_DWG_CONVERT_TIMEOUT=60

# Max accepted CAD upload size in MB. Default: 60.
GEODRILL_CAD_MAX_UPLOAD_MB=60

# Outer safety-net timeout (seconds) for the *whole* analyze/inspect call —
# DWG conversion + DXF parsing + detection combined. Generous relative to
# real-world timings (a few seconds; see the "CAD analyze timing" log line
# each request produces) — this only exists to bound a pathological or
# adversarial file, not normal operation. Default: 180.
GEODRILL_CAD_PROCESSING_TIMEOUT=180

# Override path to modules/cad/cadDetectionRules.json (pile/anchor keyword
# rules) — lets an operator tune detection keywords per firm without a
# code change. Optional.
GEODRILL_CAD_RULES_PATH=
